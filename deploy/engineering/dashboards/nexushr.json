{
  "uid": "nexushr-engineering",
  "title": "NexusHR Engineering",
  "tags": ["nexushr", "local-development"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by(service_name)(rate(http_server_request_duration_seconds_count[1m]))", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP p95 latency (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95,sum by(le,service_name)(rate(http_server_request_duration_seconds_bucket[1m]))) * 1000", "legendFormat": "{{service_name}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Container working memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by(container_label_com_docker_compose_service)(container_memory_working_set_bytes{container_label_com_docker_compose_project=\"nexushr\",image!=\"\"})", "legendFormat": "{{container_label_com_docker_compose_service}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "HTTP server errors / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by(service_name)(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))", "legendFormat": "{{service_name}}" }]
    }
  ]
}
